{
  "name": "@stormeoio/auth",
  "version": "0.1.4",
  "description": "Storm Stack — auth plugin (email/password + JWT + RBAC multi-tenant)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@stormeoio/core": "^0.1.4",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.0.0",
    "jsonwebtoken": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stormeoio/storm-stack.git",
    "directory": "packages/plugin-auth"
  },
  "homepage": "https://stormstack.dev",
  "keywords": [
    "storm-stack",
    "auth",
    "jwt",
    "rbac",
    "multi-tenant",
    "express"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "author": "Stormeo <dev@stormeo.io>"
}
