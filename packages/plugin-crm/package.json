{
  "name": "@stormstack/crm",
  "version": "0.1.0",
  "description": "Storm Stack — CRM plugin (contacts, organisations, pipeline deals)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@stormstack/auth": "^0.1.0",
    "@stormstack/core": "^0.1.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stormeoio/storm-stack.git",
    "directory": "packages/plugin-crm"
  },
  "homepage": "https://stormstack.dev",
  "keywords": [
    "storm-stack",
    "crm",
    "contacts",
    "deals",
    "pipeline",
    "sales"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "author": "Stormeo <dev@stormeo.io>"
