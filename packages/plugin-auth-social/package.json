{
  "name": "@stormstack/auth-social",
  "version": "0.1.0",
  "description": "Storm Stack — social auth plugin (Google + GitHub + GitLab OAuth2)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@stormstack/auth": "^0.1.0",
    "@stormstack/core": "^0.1.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stormeoio/storm-stack.git",
    "directory": "packages/plugin-auth-social"
  },
  "homepage": "https://stormstack.dev",
  "keywords": [
    "storm-stack",
    "oauth",
    "google",
    "github",
    "gitlab",
    "social-login"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "author": "Stormeo <dev@stormeo.io>"
}
