{
  "name": "@stormstack/testing",
  "version": "0.1.0",
  "description": "Testing utilities for Storm Stack plugins — createTestContext, createTestApp, request helpers",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@stormstack/core": "^0.1.0",
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "vitest": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": { "optional": true }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stormeoio/storm-stack.git",
    "directory": "packages/testing"
  },
  "homepage": "https://stormstack.dev",
  "keywords": [
    "storm-stack",
    "testing",
    "plugin-testing",
    "express-testing"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "author": "Stormeo <dev@stormeo.io>"
}
