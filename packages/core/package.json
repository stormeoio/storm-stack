{
  "name": "@stormstack/core",
  "version": "0.1.0",
  "description": "Storm Stack core — plugin registry, auth, multi-tenant, middleware",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.mjs",
      "require": "./dist/plugin/index.js"
    },
    "./csrf": {
      "types": "./dist/csrf.d.ts",
      "import": "./dist/csrf.mjs",
      "require": "./dist/csrf.js"
    },
    "./csrf-client": {
      "types": "./dist/csrf-client.d.ts",
      "import": "./dist/csrf-client.mjs",
      "require": "./dist/csrf-client.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "express": "^5.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stormeoio/storm-stack.git",
    "directory": "packages/core"
  },
  "homepage": "https://stormstack.dev",
  "keywords": [
    "storm-stack",
    "plugin-system",
    "express",
    "drizzle",
    "multi-tenant"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "author": "Stormeo <dev@stormeo.io>"
}
